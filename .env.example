# Copy values into your environment before launching; the app does not load .env automatically.
LATIRA_DB_PATH=./data/database/latira.sqlite3

# Environment mode: keep 'production' in real deployments; set 'demo' only for local/jury demo sessions.
LATIRA_ENV=production
LATIRA_DEMO_LOGIN=false
# Optional: set a strong value only in the local process environment to seed demo accounts on an empty DB.
# Never commit a real password here; .env files are not auto-loaded by the app.
LATIRA_DEMO_PASSWORD=
LATIRA_SESSION_TTL_SECONDS=43200
LATIRA_BASELINE_RELATIVE_DEVIATION=0.20

# Comma-separated allowed CORS origins for split deployments (e.g., Render Static Site URL).
LATIRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Launch mode for run.sh / run.bat: 'full' (installs/verifies YOLO Pose) or 'light' (lightweight core only).
# LATIRA_SKIP_YOLO_SETUP=1 is preserved as an alias for light mode.
LATIRA_MODE=full
LATIRA_SKIP_YOLO_SETUP=0

# Optional pose service reads these variables; install via install_yolo.sh / install_yolo.bat first.
YOLO_POSE_MODEL=./models/yolo11n-pose.pt
POSE_STORAGE_DIR=./data/pose
POSE_HISTORY_DB=./data/pose/history.sqlite3
POSE_MAX_UPLOAD_BYTES=104857600
LATIRA_THERMAL_DIR=./data/uploads/thermography

# External generative AI for LÁTI (server-side only; never expose keys to frontend).
# For Google AI Studio / Gemini, set GEMINI_API_KEY or LATIRA_LLM_API_KEY (base URL defaults to Gemini API).
# For an OpenAI-compatible endpoint, set LATIRA_LLM_BASE_URL, LATIRA_LLM_API_KEY, and LATIRA_LLM_MODEL.
GEMINI_API_KEY=
LATIRA_LLM_BASE_URL=
LATIRA_LLM_API_KEY=
LATIRA_LLM_MODEL=gemini-4-hydrogen
LATIRA_LLM_TIMEOUT_SECONDS=15

THERMAL_ADAPTER=none
THERMAL_API_URL=
THERMAL_API_KEY=
NASA_SOURCE_URL=
NASA_API_KEY=
