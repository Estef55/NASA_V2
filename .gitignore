# Keep local secrets, virtualenvs, caches, build outputs, and runtime data out of version control / clean releases.
.env
.env.*
!.env.example
.venv/
backend/.venv/
__pycache__/
*.py[cod]
*.sqlite3
*.db
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
*.tsbuildinfo
data/
models/*.pt
models/*.part
*.zip
